# ------------------------------------------------------------
# 環境変数の設定例
# このファイルを .env.local にコピーして値を設定してください。
#   cp .env.example .env.local
# .env.local は Git にコミットされません（.gitignore で除外済み）。
# ------------------------------------------------------------

# --- 生成AI API（Anthropic Claude）---
# 未設定の場合、アプリは「デモモード（AI未使用）」で動作します。
# APIキーは https://console.anthropic.com/ で発行できます。
ANTHROPIC_API_KEY=

# 使用するモデル（省略時: claude-opus-5-5）
# 費用を抑えたい場合は claude-sonnet-5-5 や claude-haiku-5-5 も指定できます。
ANTHROPIC_MODEL=

# --- 公開デモの保護（任意）---
# 設定すると、AIモードの利用時にこのコードの入力が必要になります。
# 公開URLにAPIキーを設定する場合は、設定を強く推奨します。
AI_ACCESS_CODE=

# 1時間あたりのAIモード利用回数の上限（IPアドレスごと・目安。省略時: 20）
AI_RATE_LIMIT_PER_HOUR=20

# --- 実績紹介ページ・営業資料に表示する情報（任意）---
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_DEMO_URL=
NEXT_PUBLIC_SOURCE_URL=
NEXT_PUBLIC_CONTACT_URL=
NEXT_PUBLIC_CONTACT_LABEL=お問い合わせ
